APP_NAME=AI Job Intelligence API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
DATABASE_URL=sqlite:///./job_intelligence.db
MAX_UPLOAD_MB=5

# Optional: set true only after installing requirements-optional.txt; first run downloads a model.
ENABLE_SEMANTIC_MODEL=false
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Optional AI question-answering (keep this key private; never put it in frontend/.env)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
